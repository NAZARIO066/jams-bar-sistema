# Chave secreta para assinar cookies de sessao
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=seu-token-hex-aqui-com-64-caracteres

# Ativar modo debug (1 = sim, 0 = nao)
FLASK_DEBUG=0

# Use 1 somente quando o sistema estiver publicado com HTTPS
SESSION_COOKIE_SECURE=0

# Credenciais do administrador
ADMIN_LOGIN=admin
ADMIN_SENHA=sua-senha-administrador-aqui

# Credenciais do funcionario
FUNC_LOGIN=funcionario
FUNC_SENHA=sua-senha-funcionario-aqui
